    {
      "name": "Create Session",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// full ISO Date (e.g., \"2026-05-19T16:55:34.000Z\")\r",
              "const today = new Date().toISOString().split('T')[0];\r",
              "pm.variables.set(\"currentDate\", today);\r",
              "\r",
              "// \"00:00:00 GMT+0000\"\r",
              "const time = new Date().toTimeString().split(' ')[0];\r",
              "pm.variables.set(\"currentTime\", time);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Create Session Success\", function(){\r",
              "    pm.response.to.have.status(200)\r",
              "});\r",
              "\r",
              "const res = pm.response.json();\r",
              "pm.environment.set(\"sessionID\", res.data.sessionID);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"date\": \"{{currentDate}}\",\r\n  \"time\": \"{{currentTime}}\"\r\n}\r\n",
          "options": {
            "raw": {
              "language": "json"
            }
          }
